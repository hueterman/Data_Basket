# Lunes a las 04:00 (hora local de la Pi: comprueba `timedatectl`).
# Persistent=true: si la Pi estaba apagada a esa hora, ejecuta la ingesta al arrancar.
[Unit]
Description=Data Basket - ingesta semanal (lunes 04:00)

[Timer]
OnCalendar=Mon *-*-* 04:00:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
