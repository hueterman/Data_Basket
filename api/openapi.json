{
  "openapi": "3.0.3",
  "info": {
    "title": "Data Basket API",
    "version": "1.0.0",
    "description": "API REST de solo lectura sobre data/processed/basketball.db: ficheros de equipos por fuente, y dos modelos entrenados (train.py / train_shot.py) servidos en vivo -- probabilidad de victoria de un partido hipotetico y probabilidad de que un tiro entre. Ninguna ruta escribe en la base de datos (ver api/README.md para el detalle completo, incluido cuando cada fuente esta disponible en cada modelo)."
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor donde corra api/app.py (ver api/README.md, 'Despliegue para demos')"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Comprobacion basica de que el proceso responde",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/model/info": {
      "get": {
        "summary": "Metadata del ultimo entrenamiento del modelo de RESULTADO DE PARTIDO (train.py)",
        "responses": {
          "200": {
            "description": "Metadata real del ultimo train.py",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameOutcomeMetadata"
                }
              }
            }
          },
          "404": {
            "description": "No se ha ejecutado train.py todavia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/model/info/shot": {
      "get": {
        "summary": "Metadata del ultimo entrenamiento del modelo de PROBABILIDAD DE TIRO (train_shot.py)",
        "responses": {
          "200": {
            "description": "Metadata real del ultimo train_shot.py",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShotMakeMetadata"
                }
              }
            }
          },
          "404": {
            "description": "No se ha ejecutado train_shot.py todavia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/model/info/margin": {
      "get": {
        "summary": "Metadata del ultimo entrenamiento del modelo de MARGEN DE VICTORIA (train_margin.py)",
        "responses": {
          "200": {
            "description": "Metadata real del ultimo train_margin.py",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameMarginMetadata"
                }
              }
            }
          },
          "404": {
            "description": "No se ha ejecutado train_margin.py todavia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/teams": {
      "get": {
        "summary": "Equipos de una fuente concreta",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "nba"
            },
            "description": "Identificador real de fuente (nba, euroleague, eurocup, nextgen, feb, lfendesa, lfchallenge, lf2, segundafeb, tercerafeb, copaespaa, acb, wnba, cbb...)"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de equipos (vacia si la fuente no tiene datos)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "team_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Falta el parametro 'source'",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Probabilidad de victoria de un partido HIPOTETICO entre dos equipos",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prediccion real",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "400": {
            "description": "Campos obligatorios ausentes, home_team_id == away_team_id, equipo/fuente/modelo desconocido, o modelos sin entrenar todavia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/predict_shot": {
      "post": {
        "summary": "Probabilidad de que un tiro HIPOTETICO entre, en unas coordenadas concretas",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictShotRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prediccion real",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictShotResponse"
                }
              }
            }
          },
          "400": {
            "description": "Campos obligatorios ausentes, source sin coordenadas calibradas, source no entrenada, shot_type invalido (incluye el caso FEB: exige 'desconocido' en vez de '2'/'3'), o player_id sin datos suficientes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "PredictRequest": {
        "type": "object",
        "required": [
          "source",
          "home_team_id",
          "away_team_id"
        ],
        "properties": {
          "source": {
            "type": "string",
            "example": "nba"
          },
          "home_team_id": {
            "type": "string",
            "example": "1610612737"
          },
          "away_team_id": {
            "type": "string",
            "example": "1610612738"
          },
          "model": {
            "type": "string",
            "enum": [
              "logreg",
              "xgboost"
            ],
            "default": "xgboost"
          },
          "home_rest_days": {
            "type": "number",
            "default": 0.0
          },
          "away_rest_days": {
            "type": "number",
            "default": 0.0
          },
          "margin_model": {
            "type": "string",
            "enum": [
              "ridge",
              "xgboost"
            ],
            "default": "xgboost",
            "description": "Modelo de MARGEN DE VICTORIA a usar (train_margin.py, AÑADIDO 2026-09-22). Un nombre invalido devuelve 400; un nombre valido pero sin entrenar todavia deja predicted_margin a null en la respuesta."
          }
        }
      },
      "PredictResponse": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "home_team_id": {
            "type": "string"
          },
          "away_team_id": {
            "type": "string"
          },
          "home_season": {
            "type": "string"
          },
          "away_season": {
            "type": "string"
          },
          "home_games_played": {
            "type": "integer"
          },
          "away_games_played": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "home_win_probability": {
            "type": "number"
          },
          "away_win_probability": {
            "type": "number"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "home_used_season_carryover": {
            "type": "boolean",
            "description": "True si home_* se calculo con arrastre de la temporada anterior (ver add_shot_priors-like _add_season_carryover en src/features_pregame.py)"
          },
          "away_used_season_carryover": {
            "type": "boolean",
            "description": "Igual que home_used_season_carryover, para el visitante."
          },
          "shap_explanation": {
            "$ref": "#/components/schemas/ShapExplanation"
          },
          "home_elo": {
            "type": "number",
            "description": "Rating ELO opponent-adjusted ACTUAL del equipo local (base 1500 = sin historial todavia). Ver 'Rating ELO opponent-adjusted' en api/README.md."
          },
          "away_elo": {
            "type": "number",
            "description": "Igual que home_elo, para el visitante."
          },
          "predicted_margin": {
            "type": "number",
            "nullable": true,
            "description": "Margen de victoria esperado en puntos (positivo = gana el local por esa diferencia, negativo = gana el visitante). AÑADIDO 2026-09-22, train_margin.py. null si ese modelo todavia no se ha entrenado."
          },
          "margin_model": {
            "type": "string",
            "nullable": true,
            "description": "Nombre del modelo de margen usado ('ridge' o 'xgboost'). null si predicted_margin es null."
          },
          "margin_shap_explanation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ShapExplanation"
              }
            ],
            "nullable": true,
            "description": "Igual que shap_explanation pero para predicted_margin (base_value + suma(shap_value) == predicted_margin sin redondear). null si predicted_margin es null."
          }
        }
      },
      "PredictShotRequest": {
        "type": "object",
        "required": [
          "source",
          "x_m",
          "y_m",
          "shot_type"
        ],
        "properties": {
          "source": {
            "type": "string",
            "example": "nba"
          },
          "x_m": {
            "type": "number",
            "description": "Metros desde el aro, eje horizontal (0 = centro)",
            "example": 0.3
          },
          "y_m": {
            "type": "number",
            "description": "Metros desde el aro, eje vertical (0 = linea de fondo)",
            "example": 0.5
          },
          "shot_type": {
            "type": "string",
            "description": "'2'/'3' salvo las 7 competiciones FEB, que exigen 'desconocido'",
            "example": "2"
          },
          "model": {
            "type": "string",
            "enum": [
              "logreg",
              "xgboost"
            ],
            "default": "xgboost"
          },
          "player_id": {
            "type": "string",
            "nullable": true,
            "description": "Opcional -- id real de jugador de esa source (ver /teams). Si se pasa, usa su acierto historico real en vez del de liga.",
            "example": "1628969"
          }
        }
      },
      "PredictShotResponse": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "x_m": {
            "type": "number"
          },
          "y_m": {
            "type": "number"
          },
          "dist_m": {
            "type": "number"
          },
          "angle_deg": {
            "type": "number"
          },
          "zone": {
            "type": "string",
            "enum": [
              "aro",
              "pintura_corta",
              "media_larga",
              "triple_esquina",
              "triple_arco"
            ]
          },
          "shot_type": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "player_id": {
            "type": "string",
            "nullable": true
          },
          "player_prior_fg": {
            "type": "number",
            "description": "Prior de acierto usado (del jugador si se paso player_id, si no el de liga de esa zona)"
          },
          "make_probability": {
            "type": "number"
          },
          "shap_explanation": {
            "$ref": "#/components/schemas/ShapExplanation"
          }
        }
      },
      "GameOutcomeMetadata": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "feature_cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_prior_games": {
            "type": "integer"
          },
          "test_frac": {
            "type": "number"
          },
          "n_train": {
            "type": "integer"
          },
          "n_test": {
            "type": "integer"
          },
          "metrics": {
            "type": "object",
            "properties": {
              "baseline": {
                "type": "object",
                "properties": {
                  "accuracy": {
                    "type": "number"
                  },
                  "log_loss": {
                    "type": "number"
                  },
                  "roc_auc": {
                    "type": "number"
                  }
                }
              },
              "logreg": {
                "type": "object",
                "properties": {
                  "accuracy": {
                    "type": "number"
                  },
                  "log_loss": {
                    "type": "number"
                  },
                  "roc_auc": {
                    "type": "number"
                  }
                }
              },
              "xgboost": {
                "type": "object",
                "properties": {
                  "accuracy": {
                    "type": "number"
                  },
                  "log_loss": {
                    "type": "number"
                  },
                  "roc_auc": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "logreg_metrics_by_source": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "n": {
                  "type": "integer"
                },
                "home_win_rate": {
                  "type": "number"
                },
                "accuracy": {
                  "type": "number"
                }
              }
            }
          },
          "available_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ShotMakeMetadata": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "feature_cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_frac": {
            "type": "number"
          },
          "n_train": {
            "type": "integer"
          },
          "n_test": {
            "type": "integer"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "baseline": {
                "type": "object",
                "properties": {
                  "accuracy": {
                    "type": "number"
                  },
                  "log_loss": {
                    "type": "number"
                  },
                  "roc_auc": {
                    "type": "number"
                  }
                }
              },
              "logreg": {
                "type": "object",
                "properties": {
                  "accuracy": {
                    "type": "number"
                  },
                  "log_loss": {
                    "type": "number"
                  },
                  "roc_auc": {
                    "type": "number"
                  }
                }
              },
              "xgboost": {
                "type": "object",
                "properties": {
                  "accuracy": {
                    "type": "number"
                  },
                  "log_loss": {
                    "type": "number"
                  },
                  "roc_auc": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "sanity_check_by_zone": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "zone": {
                  "type": "string"
                },
                "intentos": {
                  "type": "integer"
                },
                "fg_pct_real": {
                  "type": "number"
                },
                "prob_media_predicha": {
                  "type": "number"
                }
              }
            }
          },
          "league_zone_fg": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "zone": {
                  "type": "string"
                },
                "fg_pct": {
                  "type": "number"
                }
              }
            }
          },
          "shot_prior_k_shrink": {
            "type": "number"
          },
          "available_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ShapContribution": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string"
          },
          "shap_value": {
            "type": "number",
            "description": "Cuanto empuja esta feature la probabilidad respecto a base_value, en el mismo espacio que home_win_probability/make_probability (no log-odds). Positivo empuja hacia arriba, negativo hacia abajo."
          }
        }
      },
      "ShapExplanation": {
        "type": "object",
        "description": "Desglose SHAP de que feature peso mas en ESTA prediccion concreta (no en el modelo en general). base_value + suma(shap_value de todas las contributions) == home_win_probability/make_probability exactamente. contributions viene ordenado de mayor a menor peso absoluto, con una entrada por cada feature original (las columnas categoricas one-hot de /predict_shot ya vienen agregadas de vuelta a su feature original).",
        "properties": {
          "base_value": {
            "type": "number",
            "description": "Probabilidad de partida, sin mirar ninguna feature de este partido/tiro concreto."
          },
          "contributions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShapContribution"
            }
          }
        }
      },
      "GameMarginMetadata": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "feature_cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_prior_games": {
            "type": "integer"
          },
          "test_frac": {
            "type": "number"
          },
          "n_train": {
            "type": "integer"
          },
          "n_test": {
            "type": "integer"
          },
          "metrics": {
            "type": "object",
            "properties": {
              "baseline": {
                "type": "object",
                "properties": {
                  "mae": {
                    "type": "number"
                  },
                  "rmse": {
                    "type": "number"
                  },
                  "r2": {
                    "type": "number"
                  },
                  "sign_accuracy": {
                    "type": "number"
                  }
                }
              },
              "ridge": {
                "type": "object",
                "properties": {
                  "mae": {
                    "type": "number"
                  },
                  "rmse": {
                    "type": "number"
                  },
                  "r2": {
                    "type": "number"
                  },
                  "sign_accuracy": {
                    "type": "number"
                  }
                }
              },
              "xgboost": {
                "type": "object",
                "properties": {
                  "mae": {
                    "type": "number"
                  },
                  "rmse": {
                    "type": "number"
                  },
                  "r2": {
                    "type": "number"
                  },
                  "sign_accuracy": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "ridge_metrics_by_source": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "n": {
                  "type": "integer"
                },
                "margin_mean": {
                  "type": "number"
                },
                "mae": {
                  "type": "number"
                }
              }
            }
          },
          "available_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
